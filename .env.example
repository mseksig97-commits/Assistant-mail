# ─── Telegram ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# ─── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Gmail ───────────────────────────────────────────────────────────────────
# Path to the OAuth2 credentials JSON file downloaded from Google Cloud Console
GMAIL_CREDENTIALS_FILE=config/gmail_credentials.json
GMAIL_TOKEN_FILE=config/gmail_token.json

# ─── Outlook Account 1 ───────────────────────────────────────────────────────
OUTLOOK1_CLIENT_ID=your_azure_app_client_id
OUTLOOK1_CLIENT_SECRET=your_azure_app_client_secret
OUTLOOK1_TENANT_ID=your_tenant_id_or_common
OUTLOOK1_EMAIL=your_first_outlook_email@domain.com
OUTLOOK1_TOKEN_FILE=config/outlook1_token.json

# ─── Outlook Account 2 ───────────────────────────────────────────────────────
OUTLOOK2_CLIENT_ID=your_azure_app_client_id
OUTLOOK2_CLIENT_SECRET=your_azure_app_client_secret
OUTLOOK2_TENANT_ID=your_tenant_id_or_common
OUTLOOK2_EMAIL=your_second_outlook_email@domain.com
OUTLOOK2_TOKEN_FILE=config/outlook2_token.json

# ─── Google Calendar ─────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=primary

# ─── Outlook Calendar ────────────────────────────────────────────────────────
# Uses the same MSAL tokens as Outlook accounts above
OUTLOOK_CALENDAR_ACCOUNT=1   # 1 or 2 — which Outlook account holds the main calendar

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Time for the daily summary (24h format, local timezone)
DAILY_SUMMARY_TIME=08:00
TIMEZONE=Europe/Paris

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
